<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #2b2b2b;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.unijui.piu.guessquest.SecondaryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Header com Botão Voltar e Placar -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Button fx:id="backButton" onAction="#switchToPrimary" style="-fx-background-color: transparent; -fx-text-fill: #888888; -fx-cursor: hand;" text="&lt; BACK">
            <font>
                <Font name="Ithaca" size="14.0" />
            </font>
        </Button>
        <StackPane HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT">
             <Label fx:id="scoreLabel" text="SCORE: 0" textFill="#ffffffff">
                <font>
                    <Font name="Ithaca" size="24.0" />
                </font>
            </Label>
        </StackPane>
    </HBox>

    <!-- Área da Imagem -->
    <StackPane prefHeight="350.0" prefWidth="600.0">
        <children>
            <ImageView fx:id="gameImageView" fitHeight="340.0" fitWidth="600.0" pickOnBounds="true" preserveRatio="true">
                <effect>
                    <DropShadow height="20.0" radius="9.5" width="20.0" />
                </effect>
            </ImageView>
            <ProgressIndicator fx:id="loadingSpinner" maxHeight="50.0" maxWidth="50.0" visible="false" />
        </children>
    </StackPane>

    <Label fx:id="feedbackLabel" text="LOADING..." textFill="#cccccc">
        <font>
            <Font name="Ithaca" size="18.0" />
        </font>
    </Label>

    <HBox alignment="CENTER" spacing="15.0">
        <children>
            <TextField fx:id="guessField" promptText="TYPE THE GAME NAME..." style="-fx-background-radius: 0; -fx-padding: 8; -fx-border-color: #8623b4ff; -fx-border-width: 2; -fx-background-color: #1a1a1a; -fx-text-fill: white;">
                <font>
                    <Font name="Ithaca" size="14.0" />
                </font>
                <prefWidth>300.0</prefWidth>
            </TextField>
            <Button fx:id="submitButton" defaultButton="true" mnemonicParsing="false" onAction="#onGuess" style="-fx-background-color: #8623b4ff; -fx-text-fill: white; -fx-background-radius: 0; -fx-cursor: hand;" text="GUESS">
                <font>
                    <Font name="Ithaca" size="16.0" />
                </font>
                <padding>
                    <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
                </padding>
            </Button>
        </children>
    </HBox>

    <HBox alignment="CENTER" spacing="20.0">
        <Button fx:id="nextButton" mnemonicParsing="false" onAction="#onNextGame" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 0; -fx-cursor: hand;" text="SKIP (-5 PTS)">
            <font>
                <Font name="Ithaca" size="14.0" />
            </font>
        </Button>
    </HBox>
</VBox>