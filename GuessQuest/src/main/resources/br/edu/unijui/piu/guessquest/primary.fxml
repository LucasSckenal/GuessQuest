<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.Glow?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="40.0" style="-fx-background-color: #2b2b2b;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.unijui.piu.guessquest.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="GUESS QUEST" textFill="#8623b4ff">
         <font>
            <!-- Tenta usar a fonte carregada, fallback para Monospaced -->
            <Font name="Ithaca" size="64.0" />
         </font>
         <effect>
            <Glow level="0.8" />
         </effect>
      </Label>
      <Label text="PRESS START TO PLAY" textFill="WHITE">
         <font>
            <Font name="Ithaca" size="24.0" />
         </font>
      </Label>
      <Button fx:id="primaryButton" onAction="#switchToSecondary" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-width: 2; -fx-text-fill: white; -fx-cursor: hand;" text="START GAME">
         <font>
             <Font name="Ithaca" size="24.0" />
         </font>
         <padding>
            <Insets bottom="10.0" left="30.0" right="30.0" top="10.0" />
         </padding>
      </Button>
   </children>
</VBox>
