<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.unijui.piu.guessquest.PrimaryController" styleClass="root">

    <fx:define>
        <ToggleGroup fx:id="difficultyGroup" />
    </fx:define>

    <BorderPane styleClass="arcade-container" maxWidth="900" maxHeight="800" pickOnBounds="false">
        
        <top>
            <VBox alignment="CENTER" spacing="5" style="-fx-padding: 40 0 0 0;">
                <Label text="GUESS QUEST" styleClass="title-text"/>
                <Label fx:id="blinkLabel" text="INSERT COIN" styleClass="blink-text"/>
            </VBox>
        </top>

        <center>
            <StackPane>
                <VBox fx:id="screenNameInput" alignment="CENTER" spacing="40">
                    <VBox alignment="CENTER" spacing="15">
                        <Label text="ENTER INITIALS" styleClass="label-retro" style="-fx-font-size: 20px;"/>
                        
                        <StackPane>
                            <TextField fx:id="nameField" opacity="0" maxWidth="280" maxHeight="50"/>
                            
                            <HBox alignment="CENTER" spacing="15" mouseTransparent="true">
                                <Label fx:id="slot1" styleClass="char-slot" />
                                <Label fx:id="slot2" styleClass="char-slot" />
                                <Label fx:id="slot3" styleClass="char-slot" />
                                <Label fx:id="slot4" styleClass="char-slot" />
                            </HBox>
                        </StackPane>
                        
                        <Label text="MAX 4 LETTERS" style="-fx-text-fill: #666; -fx-font-size: 8px;"/>
                    </VBox>
                    
                    <Button fx:id="btnNext" text="NEXT >>" onAction="#goToDifficulty" styleClass="btn-start" prefWidth="250"/>
                </VBox>

                <VBox fx:id="screenDifficulty" alignment="CENTER" spacing="25" visible="false">
                    <Label text="SELECT SKILL LEVEL" styleClass="label-retro" style="-fx-font-size: 16px; -fx-text-fill: white;"/>
                    
                    <VBox alignment="CENTER" spacing="15">
                        <ToggleButton fx:id="tglNormal" text="NORMAL MODE" selected="true" toggleGroup="$difficultyGroup" 
                                      styleClass="diff-toggle, diff-normal"/>
                        <ToggleButton fx:id="tglHard" text="HARD MODE" toggleGroup="$difficultyGroup" 
                                      styleClass="diff-toggle, diff-hard"/>
                        <ToggleButton fx:id="tglSouls" text="NIGHTMARE" toggleGroup="$difficultyGroup" 
                                      styleClass="diff-toggle, diff-souls"/>
                    </VBox>

                    <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20 0 0 0;">
                         <Button text="&lt; BACK" onAction="#backToName" styleClass="btn-exit" prefWidth="120"/>
                         <Button text="START" onAction="#startGame" styleClass="btn-start" prefWidth="200"/>
                    </HBox>
                </VBox>

                <VBox fx:id="screenSettings" alignment="CENTER" spacing="30" visible="false">
                    <Label text="SOUND TEST" styleClass="title-text" style="-fx-font-size: 24px; -fx-text-fill: #ffcc00;"/>
                    
                    <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20; -fx-border-color: #444; -fx-border-width: 2;">
                        <HBox alignment="CENTER" spacing="20">
                            <Label text="BGM VOLUME" styleClass="label-retro" minWidth="120"/>
                            <Slider fx:id="volumeMusicSlider" styleClass="retro-slider" prefWidth="200"/>
                        </HBox>
                        
                        <HBox alignment="CENTER" spacing="20">
                            <Label text="SFX VOLUME" styleClass="label-retro" minWidth="120"/>
                            <Slider fx:id="volumeSfxSlider" styleClass="retro-slider" prefWidth="200"/>
                        </HBox>
                    </VBox>

                    <Button text="&lt; BACK TO MENU" onAction="#backToName" styleClass="btn-exit" prefWidth="200"/>
                </VBox>

            </StackPane>
        </center>

        <bottom>
            <VBox fx:id="bottomMenu" alignment="CENTER" spacing="15" style="-fx-padding: 20;">
                <HBox alignment="CENTER" spacing="20">
                    <Button text="RANK" onAction="#showLeaderboard" styleClass="btn-leaderboard"/>
                    <Button text="OPTIONS" onAction="#goToSettings" styleClass="btn-leaderboard"/> 
                    <Button text="EXIT" onAction="#exitApp" styleClass="btn-exit"/>
                </HBox>

                <VBox alignment="CENTER" spacing="10">
                    <Label text="v1.5 STYLE REFINING" style="-fx-text-fill: #666; -fx-font-size: 15px;" />
                </VBox>
            </VBox>
        </bottom>

    </BorderPane>

    <VBox styleClass="crt-overlay" mouseTransparent="true" />

</StackPane>