<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.unijui.piu.guessquest.PrimaryController" styleClass="root">

    <fx:define>
        <ToggleGroup fx:id="difficultyGroup" />
    </fx:define>

    <BorderPane styleClass="arcade-container" maxWidth="900" maxHeight="800" pickOnBounds="false">
        
        <top>
            <VBox alignment="CENTER" spacing="5" style="-fx-padding: 40 0 0 0;">
                <Label text="GUESS QUEST" styleClass="title-text"/>
                <Label fx:id="blinkLabel" text="INSERT COIN" styleClass="blink-text"/>
            </VBox>
        </top>

        <center>
            <StackPane>
                <VBox fx:id="screenNameInput" alignment="CENTER" spacing="40">
                    <VBox alignment="CENTER" spacing="15">
                        <Label text="ENTER INITIALS" styleClass="label-retro" style="-fx-font-size: 20px;"/>
                        
                        <StackPane>
                            <TextField fx:id="nameField" opacity="0" maxWidth="300" />
                            <HBox alignment="CENTER" spacing="15" mouseTransparent="true">
                                <Label fx:id="slot1" text="_" styleClass="char-slot"/>
                                <Label fx:id="slot2" text="_" styleClass="char-slot"/>
                                <Label fx:id="slot3" text="_" styleClass="char-slot"/>
                                <Label fx:id="slot4" text="_" styleClass="char-slot"/>
                            </HBox>
                        </StackPane>
                    </VBox>
                    
                    <Button text="CONFIRM" onAction="#confirmName" styleClass="btn-start" prefWidth="300" prefHeight="60"/>
                </VBox>

                <VBox fx:id="screenDifficulty" alignment="CENTER" spacing="30" visible="false">
                    <Label text="SELECT DIFFICULTY" styleClass="label-retro"/>
                    
                    <VBox alignment="CENTER" spacing="15">
                        <ToggleButton fx:id="tglNormal" text="NORMAL" toggleGroup="$difficultyGroup" styleClass="diff-toggle, diff-normal" selected="true"/>
                        <ToggleButton fx:id="tglHard" text="HARD" toggleGroup="$difficultyGroup" styleClass="diff-toggle, diff-hard"/>
                        <ToggleButton fx:id="tglSouls" text="SOULS" toggleGroup="$difficultyGroup" styleClass="diff-toggle, diff-souls"/>
                        <ToggleButton fx:id="tglInfinity" text="∞ INFINITY" toggleGroup="$difficultyGroup" styleClass="diff-toggle, diff-infinity" visible="false" managed="false"/>
                    </VBox>

                    <HBox alignment="CENTER" spacing="20">
                        <Button text="&lt; BACK" onAction="#backToNameInput" styleClass="btn-exit" prefWidth="150" prefHeight="50"/>
                        <Button text="START GAME" onAction="#startGame" styleClass="btn-start" prefWidth="250" prefHeight="50"/>
                    </HBox>
                </VBox>

                <VBox fx:id="screenSettings" alignment="CENTER" spacing="40" visible="false">
                    <Label text="SERVICE MENU" styleClass="label-retro" style="-fx-text-fill: #00eaff; -fx-font-size: 24px;"/>
                    
                    <VBox spacing="25" alignment="CENTER">
                        <HBox alignment="CENTER" spacing="20">
                            <Label text="MUSIC VOLUME" styleClass="label-retro" minWidth="150"/>
                            <Slider fx:id="volumeMusicSlider" styleClass="retro-slider" prefWidth="250"/>
                        </HBox>
                        
                        <HBox alignment="CENTER" spacing="20">
                            <Label text="SFX VOLUME" styleClass="label-retro" minWidth="150"/>
                            <Slider fx:id="volumeSfxSlider" styleClass="retro-slider" prefWidth="250"/>
                        </HBox>
                    </VBox>

                    <Button text="&lt; BACK" onAction="#backToName" styleClass="btn-exit" prefWidth="200" prefHeight="50"/>
                </VBox>

            </StackPane>
        </center>

        <bottom>
            <VBox fx:id="bottomMenu" alignment="CENTER" spacing="15" style="-fx-padding: 20;">
                <HBox alignment="CENTER" spacing="20">
                    <Button text="RANK" onAction="#showLeaderboard" styleClass="btn-leaderboard"/>
                    <Button text="OPTIONS" onAction="#goToSettings" styleClass="btn-leaderboard"/> 
                    <Button text="EXIT" onAction="#exitApp" styleClass="btn-exit"/>
                </HBox>

                <VBox alignment="CENTER" spacing="10">
                    <Label text="v2.1 FINAL" style="-fx-text-fill: #666; -fx-font-size: 15px;" />
                </VBox>
            </VBox>
        </bottom>

    </BorderPane>
</StackPane>